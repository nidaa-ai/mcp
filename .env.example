# Nidaa (نداء) — environment variables
# Copy to .env for local dev, or paste into Vercel → Project → Settings → Environment Variables.
# REQUIRED on Vercel: only the 2 Turso variables below.
# Fish Audio credentials (API key / agent / phone) are set INSIDE the app
# (بطاقة «إعدادات Fish Audio») and stored in the Turso settings table.

# ── Turso (libsql) — required ────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ── Fish Audio (optional bootstrap fallback — normally set in the app) ───────
# FISH_API_KEY=sk-fish-...
# FISH_AGENT_ID=d0df6840a7454f92aa818ff8575eeff4
# FISH_PHONE_NUMBER_ID=ab10a45646d84f1f8d31aacf359de261

# ── App ──────────────────────────────────────────────────────────────────────
# Login = email only (no password, no access code). Anyone with the link can
# sign in directly. Optionally lock it to specific emails:
# NIDAA_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
# Optional: pin the MCP/REST API key. Auto-generated & shown in the app if omitted.
# AGENT_API_KEY=
# Optional overrides (auto-derived if omitted)
# FISH_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
